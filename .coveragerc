[run]
branch = True
source =
    galerazo_bot
    scripts.frontend_release
    scripts.registry_retention
    scripts.vps_transport
    scripts.vps_operations
    deploy.vps.patch_config
omit =
    galerazo_bot/control_panel.py

[report]
show_missing = True
fail_under = 100
precision = 2

[json]
output = coverage-report.json
